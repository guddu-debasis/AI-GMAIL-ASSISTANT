APP_ENV=development
# Signs the short lived Gmail connect "state" token. Use a long random value in production, for example:
# python -c "import secre=pk_test_bWVhc3VyZWQtbWFjYXF1ZS0zNTY2LmNsZXJrLmFjY291bnRzLmRldiQts; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=dev_secret_key_change_in_production_min32chars!
# Use SQLite for quick local development or PostgreSQL for Docker/production:
DATABASE_URL=sqlite+aiosqlite:///./gmail_assistant.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gmail_assistant

# App login is handled by Clerk (https://dashboard.clerk.com)
# Use the SAME publishable key as the frontend (VITE_CLERK_PUBLISHABLE_KEY).
# The backend works out the issuer and key URL from it.
CLERK_PUBLISHABLE_KEY=
# Optional but recommended: lets the backend save the user's email on first sign in.
# Secret. Backend only, never put it in the frontend.
CLERK_SECRET_KEY=
# Optional. Origins allowed to have generated the token. Empty means "same as CORS_ORIGINS".
CLERK_AUTHORIZED_PARTIES=

# Frontend and CORS (comma separated origins allowed to call the API)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google OAuth 2.0 Credentials (Required for live Gmail sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# LLM Provider Configuration
LLM_PROVIDER=mock
# Options: mock, anthropic, groq
ANTHROPIC_API_KEY=
GROQ_API_KEY=
LLM_MODEL=

# Redis (optional for first synchronous MVP; required when asynchronous Celery worker is enabled)
REDIS_URL=redis://localhost:6379/0

# Fernet 32-byte urlsafe base64 key for encrypting OAuth tokens in database:
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_TOKEN_ENCRYPTION_KEY=
LOG_LEVEL=INFO
